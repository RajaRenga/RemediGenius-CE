  "cards": [
    {
      "dot": "cyan",
      "title": "Logical sequence, not measured timing",
      "items": [
        "Model inference occurs within Hermes turns; its separate external-data boundary is shown in the infrastructure map.",
        "AWS reads may use managed MCP or direct SDK according to configuration. Deterministic collection stays direct SDK."
      ]
    },
    {
      "dot": "cyan",
      "title": "Approval is not cloud deployment",
      "items": [
        "Deny stops the decision branch. A triage decision only changes desk records.",
        "IaC proposals use isolated validation; the operator reviews and deploys through their existing delivery process."
      ]
    },
    {
      "dot": "cyan",
      "title": "API callers have the same obligation",
      "items": [
        "Native Hermes HTTP is optional and disabled by the standard install. Use restricted tools and private authentication.",
        "Forward waiting-for-approval to a human; authentication is not permission to approve automatically."
      ]
    }
  ]
