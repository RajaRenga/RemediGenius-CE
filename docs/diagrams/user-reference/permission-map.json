  "cards": [
    {
      "dot": "cyan",
      "title": "Where things exist",
      "items": [
        "Hermes and desk run on the same EC2 instance in the desk account; they are separate processes.",
        "Instance profile and IAM roles are AWS IAM objects, not additional servers. No agent is installed in member accounts."
      ]
    },
    {
      "dot": "cyan",
      "title": "Target readers are operator-deployed",
      "items": [
        "Selected members use the standard CE reader; an explicit alternate reader ARN avoids a pre-existing role-name collision.",
        "Each target trusts only the runtime IAM ARN with an organization condition. Host policy must also allow that target."
      ]
    },
    {
      "dot": "cyan",
      "title": "Reader permissions",
      "items": [
        "SecurityAudit + ViewOnlyAccess, discovery and policy evaluation. No infrastructure deployment or IAM administration grants.",
        "Explicit denies include secrets, application object bodies, KMS decrypt and onward AssumeRole. The audit role never hops to members."
      ]
    },
    {
      "dot": "cyan",
      "title": "Credential boundary",
      "items": [
        "Container networking blocks IMDS/private networks; only fixed desk commands cross the Unix socket.",
        "The host has SSM, scoped own-storage writes and configured model-secret access. These are not grants on assessed applications."
      ]
    },
    {
      "dot": "cyan",
      "title": "Limits of the claim",
      "items": [
        "No self-service permission elevation is provided. A host compromise or externally broadened IAM policy is outside this guarantee.",
        "Existing host common-role permission matches the approved role name within the organization, not an exact selected-account allowlist. Each target still needs explicit trust."
      ]
    }
  ]
}
