  "cards": [
    {
      "dot": "cyan",
      "title": "What remains in AWS",
      "items": [
        "No bulk copy of application objects, database contents or complete log archives.",
        "Opt-in usage evidence retrieves bounded log/query results; it is not a log lake migration."
      ]
    },
    {
      "dot": "cyan",
      "title": "Why more than one representation",
      "items": [
        "Raw pages preserve evidence; Iceberg facts support history and recovery; exports make a scan human-readable.",
        "Retries do not duplicate committed batches. Separate scans and date partitions can retain repeated observations."
      ]
    },
    {
      "dot": "cyan",
      "title": "Independent checkpoint path",
      "items": [
        "Desk checkpoints Hermes, configuration, GitHub and reviewed knowledge homes to S3, normally every 120 seconds.",
        "These homes are not Iceberg facts. Uncheckpointed edits can be lost on abrupt instance loss."
      ]
    },
    {
      "dot": "cyan",
      "title": "Freshness is per scope",
      "items": [
        "A recent scan with denied or truncated coverage does not establish fresh evidence for that scope.",
        "Raw retention defaults to 90 days; snapshot expiry does not delete historical fact rows."
      ]
    }
  ]
}
