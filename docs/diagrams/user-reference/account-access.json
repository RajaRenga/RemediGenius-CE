  "cards": [
    {
      "dot": "cyan",
      "title": "Two permissions must agree",
      "items": [
        "The runtime may assume selected roles; each target role must trust that exact runtime identity.",
        "SCPs, boundaries, explicit denies and expired credentials can still block a permitted-looking path."
      ]
    },
    {
      "dot": "cyan",
      "title": "Delegation is not universal access",
      "items": [
        "Security Hub, GuardDuty and Inspector have separate regional membership and aggregation rules.",
        "Organization account inventory is not evidence that a security service covers those accounts."
      ]
    },
    {
      "dot": "cyan",
      "title": "Community onboarding",
      "items": [
        "Use onboarding --json from the actual runtime; prepare_access.py creates a private offline review packet.",
        "The operator deploys reviewed roles. Verify account, region and service coverage as the runtime afterward."
      ]
    },
    {
      "dot": "cyan",
      "title": "Release scope",
      "items": [
        "This map describes the post-v0.9.0 development branch. The newer generator is not in published v0.9.0 assets.",
        "Roles are logical: the local audit role can also be the administrator reader when it has the required access."
      ]
    }
  ]
