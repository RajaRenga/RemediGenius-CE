  "cards": [
    {
      "dot": "cyan",
      "title": "Replaceable compute",
      "items": [
        "One active writer per namespace. EC2 is disposable; S3/Glue survive replacement.",
        "Container isolation is shown. Native Hermes uses a local subprocess and shares its credential environment."
      ]
    },
    {
      "dot": "cyan",
      "title": "Operator responsibilities",
      "items": [
        "Provide outbound connectivity, model access, reader roles and retention choices.",
        "The provisioning identity stays outside the runtime. No public dashboard or agent API is required."
      ]
    },
    {
      "dot": "cyan",
      "title": "Scope",
      "items": [
        "Standard AWS deployment; connectors are logical dependencies, not separate EC2 instances.",
        "Optional GitHub and detailed account routing are in the companion guide. Post-v0.9.0 access changes are marked there."
      ]
    }
  ]
